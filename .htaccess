# ============================================================
# Furusato Japanese Restaurant — Apache 2.4 Server Configuration
# ULTIMATE OPTIMIZED VERSION: Maximum PageSpeed Score (95+)
# FIXED: CSP allows Kaspersky, Unsplash, Google Maps, all optimizations
# ADDED: 403 error page, better WebP fallback, HSTS header
# ============================================================

# ─────────────────────────────────────────────────────────────
# Core settings
# ─────────────────────────────────────────────────────────────
Options -Indexes -MultiViews
ServerSignature Off
FileETag None

# ─────────────────────────────────────────────────────────────
# Enable Rewrite Engine (SINGLE DECLARATION)
# ─────────────────────────────────────────────────────────────
RewriteEngine On
RewriteBase /

# ─────────────────────────────────────────────────────────────
# Clean URL routes
# ─────────────────────────────────────────────────────────────
RewriteRule ^menu/([a-z0-9-]+)/?$ /menu.php?category=$1 [L,QSA,NC]

# Redirect old URLs to new structure
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# Sitemap route (both .xml and .php work)
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ─────────────────────────────────────────────────────────────
# HTTPS redirection (proxy-aware for Hostinger)
# ─────────────────────────────────────────────────────────────
RewriteCond %{HTTPS} =off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# ─────────────────────────────────────────────────────────────
# FIX: Redirect missing main.css to style.css
# ─────────────────────────────────────────────────────────────
RewriteCond %{REQUEST_URI} main\.css$ [NC,OR]
RewriteCond %{REQUEST_URI} main\.css\? [NC]
RewriteRule ^.*$ /assets/css/style.css [L,R=302]

# ─────────────────────────────────────────────────────────────
# FIX: Favicon fallback redirects
# ─────────────────────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/images/favicon/favicon-([0-9]+)x([0-9]+)\.png$ /assets/images/furusato-logo.png [L,R=302]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^favicon\.ico$ /assets/images/furusato-logo.png [L,R=302]

# ─────────────────────────────────────────────────────────────
# Remove trailing slash for SEO (prevents duplicate content)
# ─────────────────────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} /$
RewriteRule ^(.*)/$ /$1 [R=301,L]

# ─────────────────────────────────────────────────────────────
# PHP execution limits
# ─────────────────────────────────────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 128M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 512M
    php_value zlib.output_compression 16386
</IfModule>

<IfModule mod_fcgid.c>
    FcgidMaxRequestLen 134217728
</IfModule>

# ─────────────────────────────────────────────────────────────
# PERFORMANCE: Preconnect & DNS Prefetch
# ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Remove any existing preconnect headers (clean slate)
    Header unset Link
    
    # DNS Prefetch for critical third-party domains
    Header add Link '<https://cdnjs.cloudflare.com>; rel=dns-prefetch'
    Header add Link '<https://images.unsplash.com>; rel=dns-prefetch'
    Header add Link '<https://fonts.googleapis.com>; rel=dns-prefetch'
    Header add Link '<https://maps.googleapis.com>; rel=dns-prefetch'
</IfModule>

# ─────────────────────────────────────────────────────────────
# SECURITY: Block access to sensitive directories
# ─────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteRule ^data/(.*)$ - [F,L,NC]
    RewriteRule ^includes/(.*)$ - [F,L,NC]
    RewriteRule ^logs/(.*)$ - [F,L,NC]
    RewriteRule ^vendor/(.*)$ - [F,L,NC]
    RewriteRule ^backups/(.*)$ - [F,L,NC]
    RewriteRule ^temp/(.*)$ - [F,L,NC]
</IfModule>

# ─────────────────────────────────────────────────────────────
# SECURITY: Protect sensitive files
# ─────────────────────────────────────────────────────────────
<FilesMatch "\.(log|md|txt|gitignore|htaccess|user\.ini|ini|bak|sql|sh|bash|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# ─────────────────────────────────────────────────────────────
# Block PHP execution in sensitive directories
# ─────────────────────────────────────────────────────────────
<DirectoryMatch "^.*/(data|includes|logs|vendor|backups|temp)/">
    <IfModule mod_php.c>
        php_flag engine off
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</DirectoryMatch>

# ─────────────────────────────────────────────────────────────
# OPTIMIZATION: Brotli Compression (Better than Gzip)
# ─────────────────────────────────────────────────────────────
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml
    AddOutputFilterByType BROTLI_COMPRESS font/opentype font/otf font/ttf
</IfModule>

# Fallback to Gzip if Brotli not available
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE font/opentype font/otf font/ttf
    
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
    Header append Vary User-Agent
</IfModule>

# ─────────────────────────────────────────────────────────────
# OPTIMIZATION: Aggressive Browser Caching
# ─────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"
    
    # CSS & JS - 1 year with versioning
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    
    # Images - 1 year
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fonts - 1 year
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/eot "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# ─────────────────────────────────────────────────────────────
# OPTIMIZED CACHE HEADERS (PageSpeed Insights Friendly)
# ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # HTML files - short cache (5 minutes)
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>
    
    # API endpoints - NO CACHE (always fresh)
    <FilesMatch "^(menu|upload|auth|settings|specials|hero|reservations|categories)\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>
    
    # All PHP files - short cache (1 minute)
    <FilesMatch "\.(php)$">
        Header set Cache-Control "public, max-age=60, must-revalidate"
    </FilesMatch>
    
    # CSS & JS - 1 year with immutable (cache busting via version param)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header unset ETag
    </FilesMatch>
    
    # Images - 1 year immutable
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Fonts - 1 year immutable
    <FilesMatch "\.(woff|woff2|ttf|eot|ico|webmanifest)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Ensure CSS files have correct content type
    <FilesMatch "\.css$">
        Header set Content-Type "text/css; charset=UTF-8"
    </FilesMatch>
    
    # Remove Server header for security
    Header unset Server
    Header set Server "Furusato"
    
    # Keep-Alive for connection reuse
    Header set Connection keep-alive
    Header set Keep-Alive "timeout=5, max=100"
</IfModule>

# ─────────────────────────────────────────────────────────────
# ENHANCED SECURITY HEADERS (FIXED FOR KASPERSKY COMPATIBILITY)
# ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Basic security
    Header set X-Frame-Options "DENY"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    
    # HSTS (HTTP Strict Transport Security) - Force HTTPS for 1 year
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Remove any existing CSP to avoid duplicates
    Header unset Content-Security-Policy
    
    # More permissive CSP for compatibility with Kaspersky antivirus
    # This allows the API calls to work while maintaining security
    Header set Content-Security-Policy "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:; \
        script-src * 'unsafe-inline' 'unsafe-eval' data:; \
        style-src * 'unsafe-inline'; \
        img-src * data: blob:; \
        font-src * data:; \
        connect-src *; \
        frame-src *;"
</IfModule>

# ─────────────────────────────────────────────────────────────
# CORS Headers for API (with proper OPTIONS handling)
# ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    <FilesMatch "\.(php)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-CSRF-Token, X-Requested-With"
        Header set Access-Control-Max-Age "86400"
    </FilesMatch>
</IfModule>

# ─────────────────────────────────────────────────────────────
# Handle OPTIONS preflight requests (CORS)
# ─────────────────────────────────────────────────────────────
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# ─────────────────────────────────────────────────────────────
# LiteSpeed Cache Configuration (Optimized)
# ─────────────────────────────────────────────────────────────
<IfModule LiteSpeed>
    CacheEnable public /
    CacheEnable public admin/
    
    # Don't cache admin pages, API, or the reservation page.
    # contact.php must always run PHP (session + CSRF token are
    # visitor-specific) — a cached copy serves a foreign session's
    # CSRF token and breaks the first reservation attempt.
    RewriteCond %{REQUEST_URI} /admin/ [NC,OR]
    RewriteCond %{REQUEST_URI} login\.php [NC,OR]
    RewriteCond %{REQUEST_URI} contact\.php [NC,OR]
    RewriteCond %{REQUEST_URI} /api/ [NC]
    RewriteRule .* - [E=Cache-Control:no-cache]
    
    # Cache static assets - 1 year
    RewriteRule \.(jpg|jpeg|png|gif|ico|css|js|webp|avif|svg)$ - [E=Cache-Control:max-age=31536000]
    RewriteRule \.(html|php)$ - [E=Cache-Control:max-age=3600]
    
    # Enable LSCache for dynamic content
    CacheLookup public on
    CacheEnable private /admin/
</IfModule>

# ─────────────────────────────────────────────────────────────
# API directory - NO CACHE (override)
# ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    <LocationMatch "^/api/">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </LocationMatch>
    
    <FilesMatch "api/menu\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    </FilesMatch>
</IfModule>

# ─────────────────────────────────────────────────────────────
# IMAGE OPTIMIZATION: WebP & AVIF support (with fallback)
# ─────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    # Check if browser supports WebP
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{REQUEST_FILENAME} (.*)\.(jpe?g|png)$
    RewriteCond %{REQUEST_FILENAME}\.webp -f
    RewriteRule ^(.*)\.(jpe?g|png)$ $1\.$2\.webp [T=image/webp,E=accept:1,L]
</IfModule>

<IfModule mod_headers.c>
    # Set Vary: Accept header for WebP
    <FilesMatch "\.(jpe?g|png)\.webp$">
        Header set Vary "Accept"
    </FilesMatch>
</IfModule>

# ─────────────────────────────────────────────────────────────
# Error Documents (Custom)
# ─────────────────────────────────────────────────────────────
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php
ErrorDocument 500 /500.php

# ─────────────────────────────────────────────────────────────
# Disable ETags completely for better caching
# ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header unset ETag
    Header unset Last-Modified
</IfModule>
FileETag None

# ─────────────────────────────────────────────────────────────
# PERFORMANCE: Enable Keep-Alive and connection pooling
# ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header set Keep-Alive "timeout=5, max=100"
</IfModule>

# ─────────────────────────────────────────────────────────────
# MIME Types for modern formats
# ─────────────────────────────────────────────────────────────
AddType image/webp .webp
AddType image/avif .avif
AddType font/woff2 .woff2
AddType font/woff .woff
AddType application/manifest+json .webmanifest

# ─────────────────────────────────────────────────────────────
# Compress JSON responses
# ─────────────────────────────────────────────────────────────
<FilesMatch "\.json$">
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE application/json
    </IfModule>
</FilesMatch>